                        { type: "WaveEffect", lifetime: 10, sizeFrom: 35.5, sizeTo: 0, strokeFrom: 3, strokeTo: 7, interp: "pow3In", colorFrom: "ffe39a", colorTo: "ffffff", layer: 110.04 }
                        { type: "WaveEffect", lifetime: 10, sizeFrom: 32.5, sizeTo: 0, strokeFrom: 3, strokeTo: 5, interp: "pow3In", colorFrom: "ffd37f77", colorTo: "ffffff00", layer: 110.035 }
                        { type: "WaveEffect", lifetime: 10, sizeFrom: 56, sizeTo: 0, strokeFrom: 1, strokeTo: 4, interp: "pow3In", colorFrom: "d4816b", colorTo: "ffe39a", layer: 110.01 }
                        { type: "ParticleEffect", lifetime: 10, region: "circle-shadow", particles: 1, length: 0, sizeFrom: 68, sizeTo: 4, interp: "pow3In", colorFrom: "ffd37fbb", colorTo: "ffffff", layer: 109.9 }
                        { type: "ParticleEffect", lifetime: 10, particles: 24, randLength: false, baseLength: 60, length: -58, cone: 180, line: true, strokeFrom: 1, strokeTo: 2.5, lenFrom: 6, lenTo: 14, interp: "pow3In", colorFrom: "ffe39a", colorTo: "ffffff", layer: 110 }
