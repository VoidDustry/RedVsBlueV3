                            { type: "ParticleEffect", lifetime: 18, region: "circle-shadow", particles: 1, length: 0, sizeFrom: 40, sizeTo: 70, interp: "pow2Out", colorFrom: "ffd37f55", colorTo: "ffd37f00", layer: 109.9 }
