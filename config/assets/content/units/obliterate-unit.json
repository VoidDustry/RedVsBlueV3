            fragBullets: 1, fragSpread: 0, fragRandomSpread: 0, fragVelocityMin: 1, fragVelocityMax: 1
            fragBullet: {
                type: "BulletType", speed: 0, lifetime: 102, damage: 0, keepVelocity: false, drawSize: 220
