    }
    // inward sparks feeding the core
    {
        type: "MoveEffectAbility", minVelocity: 0, interval: 14, amount: 1, x: 0, y: -6, parentizeEffects: true
        color: "ffd37f"
        effect: { type: "ParticleEffect", lifetime: 40, particles: 3, randLength: false, baseLength: 22, length: -20, cone: 180, line: true, strokeFrom: 0.4, strokeTo: 1.4, lenFrom: 2, lenTo: 7, interp: "pow2In", colorFrom: "d4816b00", colorTo: "ffd37f", layer: 117 }
    }
]
parts: [
    // body heat: no idle glow; hull accents only flare when the cannons fire
    { type: "RegionPart", suffix: "", drawRegion: false, outline: false, heatColor: "ffd37f", heatLayerOffset: 0.0005, heatProgress: { type: "heat", op: "mul", amount: 0.8 } }

    // ===== halo: compact, stays inside the wing holes (radius <= 25), only the spikes reach past =====
    { type: "ShapePart", circle: true, hollow: true, x: 0, y: -6, radius: 24, stroke: 1.6, color: "ffd37f", layer: 117, progress: 1 }
    { type: "ShapePart", circle: true, hollow: true, x: 0, y: -6, radius: 19, stroke: 0.6, color: "ffe39a88", layer: 117, progress: 1 }
    // two triangles spinning against each other (hexagram)
    { type: "ShapePart", hollow: true, sides: 3, x: 0, y: -6, radius: 17, stroke: 1, rotateSpeed: 0.45, color: "ffd37fcc", layer: 117, progress: 1 }
    { type: "ShapePart", hollow: true, sides: 3, x: 0, y: -6, radius: 17, stroke: 1, rotateSpeed: -0.45, color: "ffd37fcc", layer: 117, progress: 1 }
    // spikes riding the ring (outward blade + short inward nub)
    { type: "HaloPart", tri: true, shapes: 4, x: 0, y: -6, radius: 3, triLength: 14, haloRadius: 25, haloRotateSpeed: 0.7, color: "ffd37f", layer: 117, progress: 1 }
    { type: "HaloPart", tri: true, shapes: 4, x: 0, y: -6, radius: 3, triLength: 4, shapeRotation: 180, haloRadius: 25, haloRotateSpeed: 0.7, color: "ffd37f", layer: 117, progress: 1 }
    // bead chain, counter-rotating
    { type: "HaloPart", sides: 4, shapes: 8, x: 0, y: -6, radius: 1.1, haloRadius: 24, haloRotateSpeed: -1.2, color: "ffffff", layer: 117.01, progress: 1 }
    // one expanding shock ring on a loop
    {
        type: "ShapePart", circle: true, hollow: true, x: 0, y: -6, radius: 8, radiusTo: 30, stroke: 2, strokeTo: 0, color: "ffd37f", colorTo: "d4816b00", layer: 117
        progress: { type: "time", op: "loop", time: 120 }
    }
    // core
    {
        type: "ShapePart", circle: true, x: 0, y: -6, radius: 4, radiusTo: 6, color: "ffd37f44", layer: 117
        progress: { type: "time", ops: [ { op: "mul", amount: 0 }, { op: "sin", scl: 10, mag: 0.5 }, { op: "add", amount: 0.5 } ] }
    }
    { type: "ShapePart", circle: true, x: 0, y: -6, radius: 2.8, color: "ffd37f", layer: 117.01, progress: 1 }
    { type: "ShapePart", circle: true, x: 0, y: -6, radius: 1.4, color: "ffffff", layer: 117.02, progress: 1 }
    { type: "ShapePart", hollow: true, sides: 4, x: 0, y: -6, radius: 6.5, stroke: 0.8, rotateSpeed: 1.8, color: "ffd37f", layer: 117, progress: 1 }
]
