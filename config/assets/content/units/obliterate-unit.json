                    { type: "ParticleEffect", lifetime: 34, region: "circle-shadow", particles: 1, length: 0, sizeFrom: 10, sizeTo: 34, interp: "pow2Out", colorFrom: "ffd37f88", colorTo: "ffd37f00" }
