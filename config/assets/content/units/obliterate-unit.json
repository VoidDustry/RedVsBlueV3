                        { type: "ParticleEffect", lifetime: 102, region: "circle-shadow", particles: 1, length: 0, sizeFrom: 20, sizeTo: 110, interp: "pow2Out", colorFrom: "d4816b00", colorTo: "d4816b55", layer: 109.89 }
                        { type: "ParticleEffect", lifetime: 102, particles: 1, length: 0, sizeFrom: 0, sizeTo: 34, interp: "pow2Out", colorFrom: "000000", colorTo: "000000", lightOpacity: 0, layer: 110.03 }
