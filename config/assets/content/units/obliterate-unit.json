                    { type: "HaloPart", tri: true, shapes: 6, radius: 1.4, radiusTo: 2.8, triLength: 3, triLengthTo: 13, shapeRotation: 180, haloRadius: 18, haloRadiusTo: 62, haloRotateSpeed: 0.6, color: "ffd37f44", colorTo: "ffd37faa", layer: 110, progress: { type: "life", op: "curve", interp: "pow2Out" } }
