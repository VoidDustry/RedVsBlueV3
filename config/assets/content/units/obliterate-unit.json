    // ===== mouth: 3 big homing plasma orbs, 0.67 s apart, 6.8 s cooldown; glow only.
    //       Each orb leaves fire + a lingering glow pool (3 s) that pulses damage and applies Evaporating. =====
    {
        name: "obliterate-maw", x: 0, y: 6, shootY: 18, mirror: false, top: false, rotate: false
        shootCone: 12, reload: 408, inaccuracy: 2, recoil: 0, shake: 7, cooldownTime: 180
        shoot: { shots: 3, shotDelay: 40, firstShotDelay: 36 }
