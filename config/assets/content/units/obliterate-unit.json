                        { type: "WaveEffect", lifetime: 102, sizeFrom: 0, sizeTo: 30.8, strokeFrom: 0.8, strokeTo: 2.4, interp: "pow2Out", colorFrom: "d4816b00", colorTo: "ffd37f44", layer: 110.034 }
                        { type: "WaveEffect", lifetime: 102, sizeFrom: 0, sizeTo: 28.8, strokeFrom: 0.8, strokeTo: 2.2, interp: "pow2Out", colorFrom: "d4816b00", colorTo: "d4816b22", layer: 110.033 }
                        { type: "WaveEffect", lifetime: 102, sizeFrom: 0, sizeTo: 35.5, strokeFrom: 1, strokeTo: 3, interp: "pow2Out", colorFrom: "ffd37f", colorTo: "ffe39a", layer: 110.01 }
