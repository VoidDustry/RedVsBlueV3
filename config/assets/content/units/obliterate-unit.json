                        { type: "WaveEffect", lifetime: 102, sizeFrom: 4, sizeTo: 39, strokeFrom: 0.5, strokeTo: 1.6, interp: "pow2Out", colorFrom: "ffffff00", colorTo: "ffffffcc", layer: 110.01 }
                        { type: "ParticleEffect", lifetime: 102, particles: 30, randLength: false, baseLength: 112, length: -75, cone: 180, line: true, strokeFrom: 0.6, strokeTo: 2, lenFrom: 4, lenTo: 16, interp: "pow2In", colorFrom: "ffd37f00", colorTo: "ffe39a", layer: 110 }
                        { type: "ParticleEffect", lifetime: 102, particles: 18, randLength: false, baseLength: 92, length: -54, cone: 180, sizeFrom: 0.6, sizeTo: 2.6, interp: "pow3In", colorFrom: "d4816b00", colorTo: "ffd37f", layer: 110 }
                        { type: "ParticleEffect", lifetime: 102, particles: 40, randLength: false, baseLength: 150, length: -112, cone: 180, sizeFrom: 0.4, sizeTo: 1.6, interp: "pow2In", colorFrom: "ffffff00", colorTo: "ffe39a", layer: 110 }
                    ]
                }
            }
            despawnEffect: "none"
