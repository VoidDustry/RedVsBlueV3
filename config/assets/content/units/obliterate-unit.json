                { type: "ShapePart", circle: true, hollow: true, radius: 7.8, stroke: 1.1, color: "ffe39a", layer: 110.061, progress: 1 }
                { type: "ShapePart", circle: true, hollow: true, radius: 6.6, stroke: 1.3, color: "ffd37f40", layer: 110.062, progress: 1 }
                // bloom copy (bloom only processes layers ~100-110.02): halo spills out around the shell, the black core above stays black
                { type: "ShapePart", circle: true, radius: 12, color: "ffd37f55", layer: 109.9, progress: 1 }
                { type: "ShapePart", circle: true, radius: 9, color: "ffe39aaa", layer: 109.91, progress: 1 }
